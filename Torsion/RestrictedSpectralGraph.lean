module

public import Torsion.RestrictedSpectralPoincare
public import Torsion.RestrictedSpectralFourierContinuity
public import Mathlib.Topology.Sequences
public import Mathlib.Topology.Algebra.Module.Basic

@[expose] public section

set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

/-!
# The actual closed graph of the restricted half-Laplacian form

The original smooth restricted core is embedded by its value and its
frequency-side half derivative into the genuine L² product. Its closure is
an actual closed submodule, with no abstract operator replacing the original
Fourier integral or the defining core approximation.
-/

noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal ContDiff FourierTransform

namespace Torsion.Spectral

abbrev RestrictedSpectralPair :=
  Lp ℝ 2 (volume : Measure ℝ) × Lp ℂ 2 (volume : Measure ℝ)

theorem IsCore.memLp_value {f : ℝ → ℝ} (hf : IsCore f) : MemLp f 2 volume :=
  hf.1.continuous.memLp_of_hasCompactSupport hf.2.1

theorem IsCore.integrable_value {f : ℝ → ℝ} (hf : IsCore f) : Integrable f :=
  hf.1.continuous.integrable_of_hasCompactSupport hf.2.1

theorem IsCore.finiteEnergy {f : ℝ → ℝ} (hf : IsCore f) : FiniteEnergy f :=
  finiteEnergy_of_contDiff_hasCompactSupport hf.1 hf.2.1

/-- The actual source-normalized half derivative respects addition as an
L² class, independently of the choices of integrability witnesses. -/
theorem halfDerivative_add {f g : ℝ → ℝ}
    (hf : Integrable f) (hg : Integrable g) (hef : FiniteEnergy f) (heg : FiniteEnergy g) :
    halfDerivative (fun x => f x + g x) (hf.add hg) (hef.add hf hg heg) =
      halfDerivative f hf hef + halfDerivative g hg heg := by
  apply Lp.ext
  filter_upwards [halfDerivative_ae (fun x => f x + g x) (hf.add hg) (hef.add hf hg heg),
    halfDerivative_ae f hf hef, halfDerivative_ae g hg heg,
    Lp.coeFn_add (halfDerivative f hf hef) (halfDerivative g hg heg)] with ξ hsum hξf hξg hadd
  dsimp only [Pi.add_apply] at hadd
  rw [hsum, hadd, hξf, hξg]
  exact congrFun (weightedFourier_add hf hg) ξ

/-- Scalar multiplication in the actual frequency L² class. -/
theorem halfDerivative_const_mul {f : ℝ → ℝ}
    (hf : Integrable f) (hef : FiniteEnergy f) (c : ℝ) :
    halfDerivative (fun x => c * f x) (hf.const_mul c) (hef.const_mul hf c) =
      c • halfDerivative f hf hef := by
  apply Lp.ext
  filter_upwards [halfDerivative_ae (fun x => c * f x) (hf.const_mul c) (hef.const_mul hf c),
    halfDerivative_ae f hf hef, Lp.coeFn_smul c (halfDerivative f hf hef)] with ξ hc hξ hsmul
  dsimp only [Pi.smul_apply] at hsmul
  rw [hc, hsmul, hξ]
  exact congrFun (weightedFourier_const_mul c f) ξ

/-- The actual value/half-derivative graph of a restricted core function. -/
def IsCore.spectralGraph {f : ℝ → ℝ} (hf : IsCore f) : RestrictedSpectralPair :=
  ⟨hf.memLp_value.toLp f, halfDerivative f hf.integrable_value hf.finiteEnergy⟩

theorem IsCore.spectralGraph_add {f g : ℝ → ℝ} (hf : IsCore f) (hg : IsCore g) :
    (hf.add hg).spectralGraph = hf.spectralGraph + hg.spectralGraph := by
  apply Prod.ext
  · exact MemLp.toLp_add hf.memLp_value hg.memLp_value
  · exact halfDerivative_add hf.integrable_value hg.integrable_value hf.finiteEnergy hg.finiteEnergy

theorem IsCore.spectralGraph_const_mul {f : ℝ → ℝ} (hf : IsCore f) (c : ℝ) :
    (hf.const_mul c).spectralGraph = c • hf.spectralGraph := by
  apply Prod.ext
  · exact MemLp.toLp_const_smul c hf.memLp_value
  · exact halfDerivative_const_mul hf.integrable_value hf.finiteEnergy c

theorem isCore_zero : IsCore (fun _ : ℝ => 0) := by
  have hz : tsupport (fun _ : ℝ => (0 : ℝ)) = ∅ := tsupport_eq_empty_iff.mpr rfl
  refine ⟨contDiff_const, ?_, ?_⟩
  · change IsCompact (tsupport (fun _ : ℝ => (0 : ℝ)))
    rw [hz]
    exact isCompact_empty
  · rw [hz]
    exact empty_subset _

theorem isCore_zero_spectralGraph : isCore_zero.spectralGraph = 0 := by
  apply Prod.ext
  · apply Lp.ext
    filter_upwards [isCore_zero.memLp_value.coeFn_toLp, Lp.coeFn_zero ℝ 2 (volume : Measure ℝ)]
      with x hx hz
    simpa only [IsCore.spectralGraph] using! hx.trans hz.symm
  · apply Lp.ext
    filter_upwards [halfDerivative_ae (fun _ : ℝ => 0)
      isCore_zero.integrable_value isCore_zero.finiteEnergy] with ξ hξ
    simpa [IsCore.spectralGraph, weightedFourier] using hξ

/-- The actual restricted smooth graphs form a real linear subspace. -/
def restrictedCoreGraph : Submodule ℝ RestrictedSpectralPair where
  carrier := {p | ∃ f : ℝ → ℝ, ∃ hf : IsCore f, hf.spectralGraph = p}
  zero_mem' := ⟨_, isCore_zero, isCore_zero_spectralGraph⟩
  add_mem' := by
    rintro p q ⟨f, hf, rfl⟩ ⟨g, hg, rfl⟩
    exact ⟨_, hf.add hg, hf.spectralGraph_add hg⟩
  smul_mem' := by
    rintro c p ⟨f, hf, rfl⟩
    exact ⟨_, hf.const_mul c, hf.spectralGraph_const_mul c⟩

/-- The complete closed graph generated by the actual restricted core. -/
def restrictedFormGraph : Submodule ℝ RestrictedSpectralPair :=
  restrictedCoreGraph.topologicalClosure

theorem isClosed_restrictedFormGraph : IsClosed (restrictedFormGraph : Set RestrictedSpectralPair) :=
  Submodule.isClosed_topologicalClosure _

/-- Original form-domain membership yields actual membership in the closed
value/half-derivative graph. -/
theorem MemRestrictedFormDomain.mem_restrictedFormGraph {f : ℝ → ℝ}
    (hf : MemRestrictedFormDomain f) :
    (hf.1.toLp f, halfDerivative f hf.integrable hf.2.1) ∈ restrictedFormGraph := by
  obtain ⟨v, hv, hL, hE⟩ := hf.2.2.2
  change (hf.1.toLp f, halfDerivative f hf.integrable hf.2.1) ∈
    closure (restrictedCoreGraph : Set RestrictedSpectralPair)
  apply mem_closure_iff_seq_limit.mpr
  refine ⟨fun n => (hv n).spectralGraph, (fun n => ⟨v n, hv n, rfl⟩), ?_⟩
  apply Tendsto.prodMk_nhds
  · apply tendsto_iff_edist_tendsto_0.mpr
    simpa only [IsCore.spectralGraph, Lp.edist_toLp_toLp, Pi.sub_def] using! hL
  · let V : ℕ → Lp ℂ 2 (volume : Measure ℝ) :=
      fun n => halfDerivative (v n) (hv n).integrable_value (hv n).finiteEnergy
    let F : Lp ℂ 2 (volume : Measure ℝ) := halfDerivative f hf.integrable hf.2.1
    have hsq : Tendsto (fun n => ‖V n - F‖ ^ 2) atTop (𝓝 0) := by
      have heq (n : ℕ) : ‖V n - F‖ ^ 2 = (2 * Real.pi) *
          energy (fun x => v n x - f x) (fun x => v n x - f x) := by
        rw [energy_sub_eq_norm_halfDerivative_sub (hv n).integrable_value hf.integrable
          (hv n).finiteEnergy hf.2.1]
        dsimp only [V, F]
        field_simp
      simpa only [heq, mul_zero] using hE.const_mul (2 * Real.pi)
    have hnorm : Tendsto (fun n => ‖V n - F‖) atTop (𝓝 0) := by
      simpa only [Function.comp_def, Real.sqrt_sq_eq_abs, abs_norm, Real.sqrt_zero] using
        (Real.continuous_sqrt.tendsto 0).comp hsq
    exact tendsto_iff_norm_sub_tendsto_zero.mpr hnorm

/-- Every point of the actual closed graph has an actual core graph
sequence converging in both L² coordinates. -/
theorem restrictedFormGraph_exists_core_sequence (p : restrictedFormGraph) :
    ∃ v : ℕ → ℝ → ℝ, ∃ hv : ∀ n, IsCore (v n),
      Tendsto (fun n => (hv n).spectralGraph) atTop (𝓝 p.1) := by
  obtain ⟨q, hq, hlim⟩ := mem_closure_iff_seq_limit.mp p.2
  choose v hv heq using hq
  refine ⟨v, hv, ?_⟩
  simpa only [heq] using hlim

/-- Every actual closed-graph point is identified with its original
Fourier integral: no additional frequency components appear in the closure. -/
theorem restrictedFormGraph_coordinates (p : restrictedFormGraph) :
    MemRestrictedFormDomain (p.1.1 : ℝ → ℝ) ∧
      (p.1.2 : ℝ → ℂ) =ᵐ[volume] weightedFourier (p.1.1 : ℝ → ℝ) := by
  obtain ⟨v, hv, hlim⟩ := restrictedFormGraph_exists_core_sequence p
  let f : ℝ → ℝ := (p.1.1 : ℝ → ℝ)
  let F : ℕ → Lp ℂ 2 (volume : Measure ℝ) := fun n =>
    halfDerivative (v n) (hv n).integrable_value (hv n).finiteEnergy
  have hval : Tendsto (fun n => eLpNorm (fun x => v n x - f x) 2 volume) atTop (𝓝 0) := by
    have hl : Tendsto (fun n => (hv n).memLp_value.toLp (v n)) atTop
        (𝓝 ((Lp.memLp p.1.1).toLp f)) := by
      simpa only [f, IsCore.spectralGraph, Lp.toLp_coeFn] using hlim.fst_nhds
    simpa only [Lp.edist_toLp_toLp, Pi.sub_def] using! tendsto_iff_edist_tendsto_0.mp hl
  have hFreq : Tendsto F atTop (𝓝 p.1.2) := hlim.snd_nhds
  obtain ⟨hfi, hfzero, hfe, hFae⟩ := restricted_fourier_graph_limit
    (fun n => (hv n).memLp_value) (Lp.memLp p.1.1)
    (fun n => (hv n).memRestrictedFormDomain.2.2.1) hval
    (fun n => halfDerivative_ae (v n) (hv n).integrable_value (hv n).finiteEnergy) hFreq
  have hHeq : halfDerivative f hfi hfe = p.1.2 := by
    apply Lp.ext
    exact (halfDerivative_ae f hfi hfe).trans hFae.symm
  refine ⟨⟨Lp.memLp p.1.1, hfe, hfzero, v, hv, hval, ?_⟩, hFae⟩
  have hnorm : Tendsto (fun n => ‖F n - p.1.2‖) atTop (𝓝 0) :=
    tendsto_iff_norm_sub_tendsto_zero.mp hFreq
  have heq (n : ℕ) : energy (fun x => v n x - f x) (fun x => v n x - f x) =
      (1 / (2 * Real.pi)) * ‖F n - p.1.2‖ ^ 2 := by
    rw [energy_sub_eq_norm_halfDerivative_sub (hv n).integrable_value hfi
      (hv n).finiteEnergy hfe, hHeq]
  have ht : Tendsto (fun n => (1 / (2 * Real.pi)) * ‖F n - p.1.2‖ ^ 2) atTop (𝓝 0) := by
    simpa only [zero_pow (by norm_num : (2 : ℕ) ≠ 0), mul_zero] using
      (hnorm.pow 2).const_mul (1 / (2 * Real.pi))
  exact ht.congr' (Eventually.of_forall fun n => (heq n).symm)

/-- The original form predicate is equivalent to canonical closed-graph
membership for its actual value and actual half derivative. -/
theorem memRestrictedFormDomain_iff_mem_restrictedFormGraph {f : ℝ → ℝ}
    (hf : MemLp f 2 volume) (hfi : Integrable f) (hfe : FiniteEnergy f) :
    MemRestrictedFormDomain f ↔
      (hf.toLp f, halfDerivative f hfi hfe) ∈ restrictedFormGraph := by
  constructor
  · intro hm
    exact hm.mem_restrictedFormGraph
  · intro hp
    have hm := (restrictedFormGraph_coordinates
      ⟨(hf.toLp f, halfDerivative f hfi hfe), hp⟩).1
    exact hm.congr_ae hf.coeFn_toLp

end Torsion.Spectral
