  (hbound :
    ∀ (E : Torsion.ConvexDomain) (F : Torsion.Plane → ℝ) (c : ℝ),
      ContDiff ℝ (↑⊤) F →
        StrictConvex ℝ (closure E.carrier) →
          (∀ x ∈ frontier E.carrier, fderiv ℝ F x ≠ 0) →
