Torsion.ConvexDomain.exists_nearest_supported_frontier (D : Torsion.ConvexDomain) {x : Torsion.Plane}
  (hx : x ∈ D.carrier) :
  ∃ p ∈ frontier D.carrier,
    0 < Metric.infDist x D.carrierᶜ ∧
      ‖x - p‖ = Metric.infDist x D.carrierᶜ ∧
        ‖(Metric.infDist x D.carrierᶜ)⁻¹ • (x - p)‖ = 1 ∧
          ∀ z ∈ D.carrier, 0 < inner ((Metric.infDist x D.carrierᶜ)⁻¹ • (x - p)) (z - p)
