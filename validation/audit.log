Torsion.Shape.exists_local_radial_deformation {R f : ℝ → ℝ} (hR : ContinuousOn R (Set.Icc 0 Real.pi))
  (hRpos : ∀ θ ∈ Set.Icc 0 Real.pi, 0 < R θ) (hf : ContDiff ℝ (↑⊤) f) (hfc : HasCompactSupport f)
  (hfU : tsupport f ⊆ Set.Ioo 0 Real.pi) :
  ∃ V δ,
    ContDiff ℝ (↑⊤) V ∧
      HasCompactSupport V ∧
        tsupport V ⊆ Torsion.upperHalfPlane ∧
          0 < δ ∧
            (∀ (x : ℝ), V =ᶠ[nhds ↑x] 0) ∧
              (∀ θ ∈ Set.Ioo 0 Real.pi,
                  V (↑(R θ) * Complex.exp (↑θ * Complex.I)) = f θ • Complex.exp (↑θ * Complex.I)) ∧
                ∀ (t : ℝ),
                  |t| < δ →
                    (fun θ => R θ + t * f θ) ∈ Torsion.RadialFluxConcavity.positiveContinuousProfiles ∧
                      ∃ e,
                        ⇑e = Torsion.Shape.deformation V t ∧
                          ContDiff ℝ ↑⊤ ⇑e ∧
                            ContDiff ℝ ↑⊤ ⇑e.symm ∧
                              ⇑e '' Torsion.radialDomain R = Torsion.radialDomain fun θ => R θ + t * f θ
Torsion.Shape.materialSolution_hasDerivAt_zero (D : Set Torsion.Plane) (hD : MeasurableSet D)
  (hb : Bornology.IsBounded D) {V : Torsion.Plane → Torsion.Plane} (hV : ContDiff ℝ (↑⊤) V)
  (hVc : HasCompactSupport V) :
  HasDerivAt (Torsion.Shape.materialSolution D hD hb hV hVc) (Torsion.Shape.materialDerivative D hD hb hV hVc) 0
Torsion.Shape.materialDerivative_compact_test_equation (D : Set Torsion.Plane) (hD : MeasurableSet D)
  (hb : Bornology.IsBounded D) {V : Torsion.Plane → Torsion.Plane} (hV : ContDiff ℝ (↑⊤) V) (hVc : HasCompactSupport V)
  {ψ : Torsion.Plane → ℝ} (hψ : Torsion.IsTest D ψ) :
  ∫ (x : Torsion.Plane),
      inner (↑↑((Torsion.HilbertDirichlet.gradientMap D) (Torsion.Shape.materialDerivative D hD hb hV hVc)) x)
        (gradient ψ x) =
    (∫ (x : Torsion.Plane), Torsion.Shape.divergence V x * ψ x) -
      ∫ (x : Torsion.Plane),
        inner
          ((Torsion.Shape.energyVariationOperator V x)
            (↑↑((Torsion.HilbertDirichlet.gradientMap D) (Torsion.Shape.materialSolution D hD hb hV hVc 0)) x))
          (gradient ψ x)
Torsion.Shape.exists_torsionFlux_deformation_hasDerivAt {D : Set Torsion.Plane} (hD : Torsion.IsMarked D)
  {V : Torsion.Plane → Torsion.Plane} (hV : ContDiff ℝ (↑⊤) V) (hVc : HasCompactSupport V)
  (hVU : tsupport V ⊆ Torsion.upperHalfPlane) (hzero : V =ᶠ[nhds 0] fun x => 0) :
  ∃ r,
    0 < r ∧
      Torsion.upperHalfPlane ∩ Metric.ball 0 (4 * r) ⊆ D ∧
        (∀ z ∈ Metric.ball 0 (4 * r), V =ᶠ[nhds z] fun x => 0) ∧
          HasDerivAt (fun t => Torsion.torsionFlux (Torsion.Shape.deformation V t '' D))
            (Torsion.markedGradientFlux r
              ↑↑((Torsion.HilbertDirichlet.gradientMap D) (Torsion.Shape.materialDerivative D ⋯ ⋯ hV hVc)))
            0
Torsion.Shape.exists_local_radialFlux_hasDerivAt {R f : ℝ → ℝ} (hR : ContinuousOn R (Set.Icc 0 Real.pi))
  (hRpos : ∀ θ ∈ Set.Icc 0 Real.pi, 0 < R θ) (hf : ContDiff ℝ (↑⊤) f) (hfc : HasCompactSupport f)
  (hfU : tsupport f ⊆ Set.Ioo 0 Real.pi) :
  ∃ V,
    ∃ (hV : ContDiff ℝ (↑⊤) V) (hVc : HasCompactSupport V),
      ∃ r,
        tsupport V ⊆ Torsion.upperHalfPlane ∧
          0 < r ∧
            (∀ θ ∈ Set.Ioo 0 Real.pi, V (↑(R θ) * Complex.exp (↑θ * Complex.I)) = f θ • Complex.exp (↑θ * Complex.I)) ∧
              Torsion.upperHalfPlane ∩ Metric.ball 0 (4 * r) ⊆ Torsion.radialDomain R ∧
                (∀ z ∈ Metric.ball 0 (4 * r), V =ᶠ[nhds z] fun x => 0) ∧
                  HasDerivAt (fun t => Torsion.torsionFlux (Torsion.radialDomain fun θ => R θ + t * f θ))
                    (Torsion.markedGradientFlux r
                      ↑↑((Torsion.HilbertDirichlet.gradientMap (Torsion.radialDomain R))
                            (Torsion.Shape.materialDerivative (Torsion.radialDomain R) ⋯ ⋯ hV hVc)))
                    0
