Torsion.Spectral.second_signed_poisson_stationarity {t : ℝ} (ht : t ∈ Set.Icc (-1) 1) :
  Filter.Tendsto
    (fun w =>
      -inner (gradient (Torsion.Spectral.physicalCandidate Torsion.Spectral.secondEigenfunction) w)
            (Torsion.Spectral.cauchyOutwardNormal Torsion.Spectral.secondEigenfunction t) *
        -inner (gradient (Torsion.Spectral.physicalMarkedPoisson Torsion.Spectral.secondEigenfunction) w)
            (Torsion.Spectral.cauchyOutwardNormal Torsion.Spectral.secondEigenfunction t))
