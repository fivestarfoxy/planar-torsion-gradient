  Torsion.ReferenceCertificate.universal : ∀ (D : Torsion.ConvexDomain),
      T.G D ≤ ENNReal.ofReal (2 * d.stationarity * √d.area * √D.area)
constructor:
  Torsion.ReferenceCertificate.mk {T : Torsion.DirichletTheory} {d : Torsion.Moments} (domain : Torsion.ConvexDomain)
    (area_eq : domain.area = d.area) (marked_lower : ENNReal.ofReal d.flux ≤ T.G domain)
    (universal : ∀ (D : Torsion.ConvexDomain), T.G D ≤ ENNReal.ofReal (2 * d.stationarity * √d.area * √D.area)) :
    Torsion.ReferenceCertificate T d
