    Torsion.torsionTheory.cStar
Torsion.Spectral.second_radial_bound_of_smooth_local_derivative
  (hlocal :
    ∀ (f : ℝ → ℝ),
      ContDiff ℝ (↑⊤) f →
        HasCompactSupport f →
          tsupport f ⊆ Set.Ioo 0 Real.pi →
            (fun θ => (Torsion.ContinuousProfiles.extend Torsion.Spectral.secondRadialProfile) θ + f θ) ∈
                Torsion.RadialFluxConcavity.positiveContinuousProfiles →
              HasDerivWithinAt
                (fun t =>
                  Torsion.torsionFlux
                    (Torsion.radialDomain fun θ =>
                      (Torsion.ContinuousProfiles.extend Torsion.Spectral.secondRadialProfile) θ + t * f θ))
                (∫ (θ : ℝ) in Set.Ioo 0 Real.pi,
                  Torsion.Spectral.secondMoments.stationarity *
                      (Torsion.ContinuousProfiles.extend Torsion.Spectral.secondRadialProfile) θ *
                    f θ)
                (Set.Ioi 0) 0)
  (R : Torsion.ContinuousProfiles.Profile) (hR : ∀ (θ : ↑Torsion.ContinuousProfiles.Angle), 0 < R θ) :
  Torsion.torsionFlux (Torsion.radialDomain ⇑(Torsion.ContinuousProfiles.extend R)) ≤
    Torsion.Spectral.spectralConstant Torsion.Spectral.secondEigenvalue Torsion.Spectral.secondEigenfunction *
      √(Torsion.radialArea ⇑(Torsion.ContinuousProfiles.extend R))
Torsion.secondSpectralBridge_of_universal
  (huniversal :
    ∀ (D : Torsion.ConvexDomain),
      Torsion.torsionTheory.G D ≤
        ENNReal.ofReal
          (2 * Torsion.Spectral.secondMoments.stationarity * √Torsion.Spectral.secondMoments.area * √D.area)) :
  Torsion.SpectralBridge Torsion.torsionTheory Torsion.Spectral.secondEigenvalue Torsion.Spectral.secondEigenfunction
Torsion.second_exact_value_of_universal
  (huniversal :
    ∀ (D : Torsion.ConvexDomain),
      Torsion.torsionTheory.G D ≤
        ENNReal.ofReal
          (2 * Torsion.Spectral.secondMoments.stationarity * √Torsion.Spectral.secondMoments.area * √D.area)) :
  Torsion.torsionTheory.cStar =
      ENNReal.ofReal
        (Torsion.Spectral.spectralConstant Torsion.Spectral.secondEigenvalue Torsion.Spectral.secondEigenfunction) ∧
    ∃ D,
      D.carrier =
          Torsion.Spectral.normalizedImage Torsion.Spectral.secondEigenvalue Torsion.Spectral.secondEigenfunction ∧
        D.area = 1 ∧
          Torsion.torsionTheory.G D =
            ENNReal.ofReal
              (Torsion.Spectral.spectralConstant Torsion.Spectral.secondEigenvalue Torsion.Spectral.secondEigenfunction)
