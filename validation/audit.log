  Torsion.Spectral.energy Torsion.Spectral.secondEigenfunction ⇑S =
    ∫ (x : ℝ),
      (Torsion.Spectral.secondEigenvalue * Torsion.Spectral.secondEigenfunction x -
          Torsion.Spectral.exteriorResidualZero Torsion.Spectral.secondEigenfunction x) *
        S x
Torsion.Spectral.secondEigenfunction_second_deriv_eq (x : ℝ) (hx : x ∈ Set.Ioo (-1) 1) :
  deriv (deriv Torsion.Spectral.secondEigenfunction) x =
    -Torsion.Spectral.secondEigenvalue ^ 2 * Torsion.Spectral.secondEigenfunction x -
      1 / Real.pi *
        ∫ (y : ℝ), Torsion.Spectral.exteriorResidualZero Torsion.Spectral.secondEigenfunction y / (x - y) ^ 2
