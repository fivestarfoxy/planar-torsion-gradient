Torsion.Spectral.physicalGreen_regular_part_tendsto {φ : ℝ → ℝ} (hφ : Continuous φ) (hodd : Function.Odd φ)
  (hzero : ∀ (x : ℝ), 1 ≤ |x| → φ x = 0) (hpos : ∀ x ∈ Set.Ioo 0 1, 0 < φ x) {z : Torsion.Plane}
  (hz : z ∈ Torsion.upperHalfPlane) :
  Filter.Tendsto
    (fun w =>
      Torsion.Spectral.physicalGreen φ w (Torsion.Spectral.cauchy φ z) +
        Real.log ‖w - Torsion.Spectral.cauchy φ z‖ / (2 * Real.pi))
    (nhdsWithin (Torsion.Spectral.cauchy φ z) {Torsion.Spectral.cauchy φ z}ᶜ)
    (nhds ((Real.log ‖z - star z‖ - Real.log ‖(deriv (Torsion.Spectral.cauchy φ) z)⁻¹‖) / (2 * Real.pi)))
Torsion.Spectral.physicalGreen_marked_source_quotient_tendsto {φ : ℝ → ℝ} (hφ : Continuous φ) (hodd : Function.Odd φ)
  (hzero : ∀ (x : ℝ), 1 ≤ |x| → φ x = 0) (hpos : ∀ x ∈ Set.Ioo 0 1, 0 < φ x) {w : Torsion.Plane}
  (hw : w ∈ Torsion.Spectral.cauchyImage φ) :
