  (E : ℕ → Torsion.ConvexDomain) (δ : ℕ → ℝ) (hδ : ∀ (n : ℕ), 0 < δ n) (hδlim : Filter.Tendsto δ Filter.atTop (nhds 0))
  (hDE : ∀ (n : ℕ), D.carrier ⊆ (E n).carrier) (hED : ∀ (n : ℕ), (E n).carrier ⊆ Metric.thickening (δ n) D.carrier) :
