  HasDerivAt (Torsion.Shape.uniformEnergyCoefficient hV hVc i j) (Torsion.Shape.uniformEnergyVariation hV hVc i j) 0
Torsion.Shape.uniformEnergyCoefficient_eventually_apply {V : Torsion.Plane → Torsion.Plane} (hV : ContDiff ℝ (↑⊤) V)
  (hVc : HasCompactSupport V) :
