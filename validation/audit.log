    ∀ x ∈ Set.Ioo (-1) 1,
      Torsion.Spectral.realCauchyBoundaryRe Torsion.Spectral.secondEigenfunction x =
        Torsion.Spectral.secondEigenvalue * Torsion.Spectral.height Torsion.Spectral.secondEigenfunction x - b
Torsion.Spectral.exists_second_restricted_spectral_profile :
  ∃ φ C,
    Torsion.Spectral.IsRestrictedEigenfunction Torsion.Spectral.secondEigenvalue φ ∧
      Function.Odd φ ∧
        (∀ (x : ℝ), 1 ≤ |x| → φ x = 0) ∧
          ∫ (x : ℝ), φ x ^ 2 = 1 ∧
            AnalyticOnNhd ℝ φ (Set.Ioo (-1) 1) ∧
              (∀ x ∈ Set.Ioo 0 1, 0 < φ x) ∧
                StrictConcaveOn ℝ (Set.Icc 0 1) φ ∧
                  HolderWith C (1 / 2) φ ∧
                    ∀ (g : ℝ → ℝ),
                      Torsion.Spectral.IsRestrictedEigenfunction Torsion.Spectral.secondEigenvalue g →
                        ∃ c, g =ᵐ[MeasureTheory.volume] fun x => c * φ x
