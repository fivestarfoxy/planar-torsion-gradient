  (hzero : 0 ∈ closure D.carrier) {ε : ℝ} (hε : 0 < ε) :
  ∃ E, Torsion.IsMarked E.carrier ∧ D.carrier ⊆ E.carrier ∧ E.carrier ⊆ Metric.thickening ε D.carrier
Torsion.DirichletTheory.G_isometryPreimage (T : Torsion.DirichletTheory) (D : Torsion.ConvexDomain)
  (e : Torsion.Plane ≃ₗᵢ[ℝ] Torsion.Plane) : T.G (D.isometryPreimage e) = T.G D
Torsion.IsWeakTorsion.exists_continuous_smooth_representative {D : Torsion.ConvexDomain} {u : Torsion.Plane → ℝ}
  {g : Torsion.Plane → Torsion.Plane} (hu : Torsion.IsWeakTorsion D.carrier u g) :
  ∃ U,
    Continuous U ∧
      ContDiffOn ℝ (↑⊤) U D.carrier ∧
        (∀ x ∉ D.carrier, U x = 0) ∧
          (∀ (x : Torsion.Plane), 0 ≤ U x) ∧
            u =ᵐ[MeasureTheory.volume.restrict D.carrier] U ∧ g =ᵐ[MeasureTheory.volume.restrict D.carrier] gradient U
Torsion.IsWeakTorsion.lipschitzWith_of_boundary_collar_approx {D : Set Torsion.Plane} {u U : Torsion.Plane → ℝ}
  {g : Torsion.Plane → Torsion.Plane} (hu : Torsion.IsWeakTorsion D u g) (hD : IsOpen D) (hb : Bornology.IsBounded D)
  (hc : Continuous U) (hs : ContDiffOn ℝ (↑⊤) U D) (hgrad : g =ᵐ[MeasureTheory.volume.restrict D] gradient U)
  (hzero : ∀ x ∉ D, U x = 0) (hpos : ∀ (x : Torsion.Plane), 0 ≤ U x) {L : NNReal}
  (hcollar :
    ∀ (ε : NNReal), 0 < ε → ∃ δ, 0 < δ ∧ ∀ x ∈ D, Metric.infDist x Dᶜ < δ → U x ≤ ↑(L + ε) * Metric.infDist x Dᶜ) :
