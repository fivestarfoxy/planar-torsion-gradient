  (hα1 : α ≤ 1) (hodd : Function.Odd φ) (hzero : ∀ (s : ℝ), 1 ≤ |s| → φ s = 0) (hpos : ∀ s ∈ Set.Ioo 0 1, 0 < φ s)
  {v p : Torsion.Plane} (hv : v ∈ Torsion.Spectral.cauchyImage φ) (hp : p ∈ frontier (Torsion.Spectral.cauchyImage φ)) :
  Filter.Tendsto (fun w => Torsion.Spectral.physicalGreen φ w v) (nhdsWithin p (Torsion.Spectral.cauchyImage φ))
