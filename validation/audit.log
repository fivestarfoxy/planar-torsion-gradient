Torsion.ConvexDomain.exists_smooth_strictConvex_outer_sequence (D : Torsion.ConvexDomain) :
  ∃ E F b,
    (∀ (n : ℕ),
        ContDiff ℝ (↑⊤) (F n) ∧
          StrictConvexOn ℝ Set.univ (F n) ∧
            StrictConvex ℝ (closure (E n).carrier) ∧
              (∀ x ∈ frontier (E n).carrier, fderiv ℝ (F n) x ≠ 0) ∧ (E n).carrier = {x | F n x < b n}) ∧
      (∀ (n : ℕ), D.carrier ⊆ (E n).carrier) ∧ ∀ (n : ℕ), (E n).carrier ⊆ Metric.thickening (1 / (↑n + 1)) D.carrier
Torsion.DirichletTheory.G_area_bound_of_smooth_strictConvex (T : Torsion.DirichletTheory) (c : ℝ)
  (hbound :
    ∀ (E : Torsion.ConvexDomain) (F : Torsion.Plane → ℝ) (b : ℝ),
      ContDiff ℝ (↑⊤) F →
        StrictConvex ℝ (closure E.carrier) →
          (∀ x ∈ frontier E.carrier, fderiv ℝ F x ≠ 0) →
            E.carrier = {x | F x < b} → T.G E ≤ ENNReal.ofReal (c * √E.area))
  (D : Torsion.ConvexDomain) : T.G D ≤ ENNReal.ofReal (c * √D.area)
