    ((∫ (s : ℝ) in Set.Icc (-1) 1, Torsion.Spectral.shapeBoundaryData a φ V s) / Torsion.Spectral.mass φ) 0
Torsion.Spectral.torsionFlux_cauchy_boundary_hadamard {a b : ℝ} {φ : ℝ → ℝ} {C α : NNReal}
  (hEig : Torsion.Spectral.IsRestrictedEigenfunction a φ) (ha : 0 < a) (hφ : HolderWith C α φ) (hα0 : 0 < α)
  (hα1 : α ≤ 1) (hodd : Function.Odd φ) (hzero : ∀ (s : ℝ), 1 ≤ |s| → φ s = 0) (hpos : ∀ s ∈ Set.Ioo 0 1, 0 < φ s)
  (hlinear : ∀ s ∈ Set.Ioo (-1) 1, Torsion.Spectral.realCauchyBoundaryRe φ s = a * Torsion.Spectral.height φ s - b)
  {V : Torsion.Plane → Torsion.Plane} (hV : ContDiff ℝ (↑⊤) V) (hVc : HasCompactSupport V)
  (hVU : tsupport V ⊆ Torsion.upperHalfPlane) :
  HasDerivAt (fun t => Torsion.torsionFlux (Torsion.Shape.deformation V t '' Torsion.Spectral.cauchyImage φ))
    (∫ (s : ℝ) in Set.Icc (-1) 1,
      ‖Torsion.Spectral.cauchyDerivativeExtension φ ↑s‖ / (2 * a) *
            (1 / (Torsion.Spectral.mass φ * ‖Torsion.Spectral.cauchyDerivativeExtension φ ↑s‖)) *
          inner (V (Torsion.Spectral.cauchyExtension φ ↑s)) (Torsion.Spectral.cauchyOutwardNormal φ s) *
        ‖Torsion.Spectral.cauchyDerivativeExtension φ ↑s‖)
    0
Torsion.Spectral.cauchy_radial_torsionFlux_hasDerivAt {a b : ℝ} {φ : ℝ → ℝ} {C α : NNReal}
  (hEig : Torsion.Spectral.IsRestrictedEigenfunction a φ) (ha : 0 < a) (hφ : HolderWith C α φ) (hα0 : 0 < α)
  (hα1 : α ≤ 1) (hodd : Function.Odd φ) (hzero : ∀ (x : ℝ), 1 ≤ |x| → φ x = 0) (hpos : ∀ x ∈ Set.Ioo 0 1, 0 < φ x)
  (hlinear : ∀ x ∈ Set.Ioo (-1) 1, Torsion.Spectral.realCauchyBoundaryRe φ x = a * Torsion.Spectral.height φ x - b)
  (hc : ConcaveOn ℝ (Set.Ioo 0 1) φ) (hd : ∀ x ∈ Set.Ioo 0 1, DifferentiableAt ℝ φ x) (f : ℝ → ℝ)
  (hf : ContDiff ℝ (↑⊤) f) (hfc : HasCompactSupport f) (hfU : tsupport f ⊆ Set.Ioo 0 Real.pi) :
  HasDerivAt
    (fun t =>
      Torsion.torsionFlux
        (Torsion.radialDomain fun θ =>
          (Torsion.ContinuousProfiles.extend
                (Torsion.Spectral.cauchyRadialProfile ha hφ hα0 hα1 hodd hzero hpos hlinear hc hd))
              θ +
            t * f θ))
    (1 / (2 * a * Torsion.Spectral.mass φ) *
      ∫ (θ : ℝ) in Set.Ioo 0 Real.pi,
        (Torsion.ContinuousProfiles.extend
              (Torsion.Spectral.cauchyRadialProfile ha hφ hα0 hα1 hodd hzero hpos hlinear hc hd))
            θ *
          f θ)
    0
