  (hEig : Torsion.Spectral.IsRestrictedEigenfunction a φ) (ha : 0 < a) (hφ : HolderWith C α φ) (hα0 : 0 < α)
  (hα1 : α ≤ 1) (hodd : Function.Odd φ) (hzero : ∀ (s : ℝ), 1 ≤ |s| → φ s = 0) (hpos : ∀ s ∈ Set.Ioo 0 1, 0 < φ s)
  (hlinear : ∀ s ∈ Set.Ioo (-1) 1, Torsion.Spectral.realCauchyBoundaryRe φ s = a * Torsion.Spectral.height φ s - b)
  {V : Torsion.Plane → Torsion.Plane} (hV : ContDiff ℝ (↑⊤) V) (hVc : HasCompactSupport V)
