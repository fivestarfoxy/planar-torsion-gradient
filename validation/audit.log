Torsion.Shape.exists_MemH10_transport_deformation {V : Torsion.Plane → Torsion.Plane} (hV : ContDiff ℝ (↑⊤) V)
  (hVc : HasCompactSupport V) :
  ∃ δ,
    0 < δ ∧
      ∀ (t : ℝ),
        |t| < δ →
          ∃ e,
            ⇑e = Torsion.Shape.deformation V t ∧
              ContDiff ℝ ↑⊤ ⇑e.symm ∧
                (∀ (D : Set Torsion.Plane) (u : Torsion.Plane → ℝ) (g : Torsion.Plane → Torsion.Plane),
                    Torsion.MemH10 (Torsion.Shape.deformation V t '' D) u g →
                      Torsion.MemH10 D (u ∘ ⇑e) (Torsion.Shape.gradientPullback (⇑e) g)) ∧
                  ∀ (D : Set Torsion.Plane) (u : Torsion.Plane → ℝ) (g : Torsion.Plane → Torsion.Plane),
                    Torsion.MemH10 D u g →
                      Torsion.MemH10 (Torsion.Shape.deformation V t '' D) (u ∘ ⇑e.symm)
                        (Torsion.Shape.gradientPullback (⇑e.symm) g)
Torsion.Shape.exists_weakTorsion_pullback_deformation {V : Torsion.Plane → Torsion.Plane} (hV : ContDiff ℝ (↑⊤) V)
  (hVc : HasCompactSupport V) :
  ∃ δ,
    0 < δ ∧
      ∀ (t : ℝ),
        |t| < δ →
          ∃ e,
            ⇑e = Torsion.Shape.deformation V t ∧
              ContDiff ℝ ↑⊤ ⇑e.symm ∧
                ∀ (D : Set Torsion.Plane),
                  MeasurableSet D →
                    ∀ (u : Torsion.Plane → ℝ) (g : Torsion.Plane → Torsion.Plane),
                      Torsion.IsWeakTorsion (Torsion.Shape.deformation V t '' D) u g →
                        Torsion.MemH10 D (u ∘ ⇑e) (Torsion.Shape.gradientPullback (⇑e) g) ∧
                          ∀ (v : Torsion.Plane → ℝ) (h : Torsion.Plane → Torsion.Plane),
                            Torsion.MemH10 D v h →
                              ∫ (z : Torsion.Plane) in D,
                                  inner
                                    ((Torsion.Shape.pullbackEnergyOperator e z)
                                      (Torsion.Shape.gradientPullback (⇑e) g z))
                                    (h z) =
                                ∫ (z : Torsion.Plane) in D, (fderiv ℝ (⇑e) z).det * v z
Torsion.Shape.realMatrix_pullbackEnergyOperator_deformation {V : Torsion.Plane → Torsion.Plane} (hV : ContDiff ℝ (↑⊤) V)
  (t : ℝ) (e : Torsion.Plane ≃ₜ Torsion.Plane) (heq : ⇑e = Torsion.Shape.deformation V t)
