  (hs : ∀ (n : ℕ), 0 < s n) (hslim : Filter.Tendsto s Filter.atTop (nhds 1)) (hDE : ∀ (n : ℕ), D ⊆ E n)
  (hEsD : ∀ (n : ℕ), E n ⊆ s n • D) :
