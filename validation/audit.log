structure Torsion.ReferenceCertificate (T : Torsion.DirichletTheory) (d : Torsion.Moments) : Type
number of parameters: 2
fields:
  Torsion.ReferenceCertificate.domain : Torsion.ConvexDomain
  Torsion.ReferenceCertificate.area_eq : self.domain.area = d.area
