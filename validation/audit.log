Torsion.Spectral.IsRestrictedEigenfunction.height_analyticAt_of_odd {a : ℝ} {φ : ℝ → ℝ}
  (hEig : Torsion.Spectral.IsRestrictedEigenfunction a φ) (hodd : Function.Odd φ) (x : ℝ) (hx : x ∈ Set.Ioo (-1) 1) :
