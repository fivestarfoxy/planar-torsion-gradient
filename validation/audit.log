  (hzero : ∀ (s : ℝ), 1 ≤ |s| → φ s = 0) (hpos : ∀ s ∈ Set.Ioo 0 1, 0 < φ s) (hg : ContinuousOn g (Set.Icc (-1) 1)) :
  Filter.Tendsto (fun t => Torsion.Spectral.physicalHarmonicLift φ g (↑t * Complex.I) / t) (nhdsWithin 0 (Set.Ioi 0))
    (nhds ((∫ (s : ℝ) in Set.Icc (-1) 1, g s) / Torsion.Spectral.mass φ))
Torsion.Spectral.physicalHarmonicLift_marked_boundary_tendsto {φ g : ℝ → ℝ} {C α : NNReal} (hφ : HolderWith C α φ)
  (hα0 : 0 < α) (hα1 : α ≤ 1) (hodd : Function.Odd φ) (hzero : ∀ (s : ℝ), 1 ≤ |s| → φ s = 0)
  (hpos : ∀ s ∈ Set.Ioo 0 1, 0 < φ s) (hg : ContinuousOn g (Set.Icc (-1) 1)) :
