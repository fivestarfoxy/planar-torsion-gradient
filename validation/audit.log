  ∃ a₁ a₂,
    0 < a₁ ∧
      a₁ ≤ a₂ ∧
        ∃ φ₁ φ₂,
          Torsion.Spectral.IsRestrictedEigenfunction a₁ φ₁ ∧
            Torsion.Spectral.IsRestrictedEigenfunction a₂ φ₂ ∧
              ∫ (x : ℝ), φ₁ x ^ 2 = 1 ∧
                ∫ (x : ℝ), φ₂ x ^ 2 = 1 ∧
                  ∫ (x : ℝ), φ₁ x * φ₂ x = 0 ∧
                    Function.Even φ₁ ∧
                      (∀ (x : ℝ), 0 ≤ φ₁ x) ∧
                        (∀ (ψ : ℝ → ℝ),
                            Torsion.Spectral.MemRestrictedFormDomain ψ →
                              a₁ * ∫ (x : ℝ), ψ x ^ 2 ≤ Torsion.Spectral.energy ψ ψ) ∧
                          ∀ (ψ : ℝ → ℝ),
                            Torsion.Spectral.MemRestrictedFormDomain ψ →
