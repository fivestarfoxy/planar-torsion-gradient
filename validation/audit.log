  (h₀ : R₀ ∈ Torsion.RadialFluxConcavity.positiveContinuousProfiles)
  (hR : R ∈ Torsion.RadialFluxConcavity.positiveContinuousProfiles) (hγ : ContinuousOn γ (Set.Icc 0 Real.pi))
  (heuler : Torsion.torsionFlux (Torsion.radialDomain R₀) = ∫ (θ : ℝ) in Set.Ioo 0 Real.pi, γ θ * R₀ θ)
  (hlocal :
    ∀ (f : ℝ → ℝ),
      ContDiff ℝ (↑⊤) f →
        HasCompactSupport f →
          tsupport f ⊆ Set.Ioo 0 Real.pi →
            (fun θ => R₀ θ + f θ) ∈ Torsion.RadialFluxConcavity.positiveContinuousProfiles →
              HasDerivWithinAt (fun t => Torsion.torsionFlux (Torsion.radialDomain fun θ => R₀ θ + t * f θ))
                (∫ (θ : ℝ) in Set.Ioo 0 Real.pi, γ θ * f θ) (Set.Ioi 0) 0) :
