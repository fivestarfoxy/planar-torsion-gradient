  (E : ℕ → Torsion.ConvexDomain) {r : ℝ} (hr : 0 < r) (hball : Metric.ball 0 r ⊆ D.carrier) (δ : ℕ → ℝ)
  (hδ : ∀ (n : ℕ), 0 < δ n) (hδlim : Filter.Tendsto δ Filter.atTop (nhds 0))
